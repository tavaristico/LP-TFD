# Copie este arquivo para .env.local e preencha os valores reais.
# .env.local NUNCA vai para o git.

# Brevo (ex-Sendinblue) — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-...

# ID da lista de contatos criada no painel Brevo
BREVO_LIST_ID=123

# ID do template de e-mail de boas-vindas criado no painel Brevo
BREVO_TEMPLATE_ID=1

# E-mail remetente (deve ter domínio verificado com SPF + DKIM)
BREVO_SENDER_EMAIL=diario@melfiore.com
BREVO_SENDER_NAME=MELFIORE

# E-mail que recebe as submissões do arquivo fiorettes (notificação de curadoria)
FIORETTES_NOTIFY_EMAIL=thebrazilianfactory@gmail.com

# Contato unico (2A.3). Desligado por padrao: so ligar em producao com pedido do fundador.
# CRM_ENVIO=ligado
# SUPABASE_URL=
# Chave publishable do projeto (publica por desenho). Vai no header apikey: o gateway recusa JWT customizado ali.
# SUPABASE_PUBLISHABLE_KEY=
# JWT assinado com role=captura_web (migration 009). NUNCA a service_role no Worker.
# SUPABASE_CAPTURA_JWT=
# CRM_IP_SALT=
