{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "melfiore",
  "main": "custom-worker.ts", // handler do OpenNext + cron da fila (lib/fila-agendada.ts)
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // E-mail ligado a pedido do fundador em 03/11/2026 16h46 ("Deixa ativo"): boas-vindas = template Brevo 1 "DIÁRIO I"
    "EMAIL_ENVIO": "ligado",
    "BREVO_TEMPLATE_ID": "1",
    "BREVO_SENDER_EMAIL": "diario@melfiore.com",
    "BREVO_SENDER_NAME": "MELFIORE"
  },
  // Fila de reenvio da captura. Namespace CAPTURA_FILA criado em 06/11/2026 (sem efeito ate o deploy).
  // Falta ligar, SO com pedido do fundador (DEVOLUTIVA-2026-11-06.md, item 24): CRM_ENVIO=ligado nas vars,
  // o cron abaixo, e o deploy. Com a flag desligada o cron so registra no log e sai.
  "kv_namespaces": [{ "binding": "CAPTURA_FILA", "id": "eaa8592a78454236b8cd4cd582678aa9" }],
  // Cron que esvazia a fila sem depender de nova inscricao (custom-worker.ts, scheduled). Continua comentado.
  // "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [
    { "pattern": "melfiore.com", "custom_domain": true },
    { "pattern": "www.melfiore.com", "custom_domain": true }
  ]
}
